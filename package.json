{
  "name": "veo-auto-studio",
  "version": "1.0.2",
  "description": "Veo Auto Studio - AI Video Generator",
  "main": "electron/main.cjs",
  "author": "Zaquiel Francisco Sousa",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "echo Electron files are JavaScript - no TypeScript compilation required",
    "build:full": "npm run build && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build:full && electron-builder --win",
    "release": "npm run build:full && electron-builder --win --publish always"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.veoautostudio.app",
    "productName": "Veo Auto Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Veo-Auto-Studio-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zaquielmcc73-sketch",
        "repo": "zaquielreis",
        "releaseType": "release"
      }
    ]
  }
}
